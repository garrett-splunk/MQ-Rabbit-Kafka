# Splunk Observability Cloud secrets (template only — safe to commit).
# Real credentials go in .env.splunk (gitignored — never commit this file).
#
# ── Setup (do this once before your first demo) ─────────────────────────────
#
# 1. From the repo root, create your local secrets file:
#
#      cp .env.splunk.example .env.splunk
#
# 2. Edit .env.splunk and paste your ingest token:
#
#      nano .env.splunk
#      # or open in Cursor: MQ-Rabbit-Kafka/.env.splunk
#
# 3. Set SPLUNK_ACCESS_TOKEN= to your token (no quotes, no spaces around =).
#
# 4. Match SPLUNK_REALM and the ingest/api URLs to your org (us0, us1, eu0, …).
#
# 5. Restart the collector so it picks up the new values:
#
#      docker compose up -d otel-collector
#
# ── Where to get a token in Splunk O11y ─────────────────────────────────────
#
# Splunk Observability Cloud → Settings (gear) → Organization Settings
#   → Access Tokens → New Token → type: Ingest
#
# Copy the token once (it is not shown again). Use an ingest token, not an API token.
#
# ── Verify (does not print the token) ───────────────────────────────────────
#
#   test -f .env.splunk && grep -q '^SPLUNK_ACCESS_TOKEN=.' .env.splunk && echo "OK: token file present"
#
# In Splunk: Metric Explorer → filter deployment.environment:messaging-demo-lab

SPLUNK_REALM=us1
SPLUNK_ACCESS_TOKEN=your-ingest-token-here
SPLUNK_INGEST_URL=https://ingest.us1.signalfx.com
SPLUNK_API_URL=https://api.us1.signalfx.com
