# Non-secret application configuration
DEPLOYMENT_ENVIRONMENT=messaging-demo-lab
# false = export OTLP traces from MQ sample apps (APM demo)
OTEL_SDK_DISABLED=false

# IBM MQ
MQ_QUEUE_MANAGER=QM1
MQ_CONN_NAME=mq(1414)
MQ_CHANNEL=DEV.APP.SVRCONN
MQ_USER=app
MQ_APP_PASSWORD=passw0rd
MQ_ADMIN_PASSWORD=passw0rd
MQ_REQUEST_QUEUE=ORDER.REQ
MQ_RESPONSE_QUEUE=ORDER.RESP
PRODUCER_PORT=8080

# RabbitMQ (collector rabbitmq receiver + optional traffic scripts)
RABBITMQ_USER=demo
RABBITMQ_PASSWORD=passw0rd
RABBITMQ_QUEUE=demo.orders
